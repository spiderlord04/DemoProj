# Google Gemini API key (Required for live AI script generation)
GEMINI_API_KEY=

# Pexels API key (Optional: Get a free key at https://www.pexels.com/api/ to enable real video clips)
PEXELS_API_KEY=

# MongoDB Connection URI (Optional)
MONGO_URI=

# AI Models
GEMINI_MODEL=gemini-2.5-flash
SD_MODEL=SG161222/Realistic_Vision_V5.1_noVAE
USE_STABLE_DIFFUSION=false
WHISPER_MODEL=base

# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
