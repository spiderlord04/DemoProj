# Google Gemini API key (Required for live AI script generation)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# MongoDB Connection URI (Optional: Leave blank for local standalone mode)
MONGO_URI=

# AI Models
GEMINI_MODEL=gemini-2.5-flash
SD_MODEL=SG161222/Realistic_Vision_V5.1_noVAE
USE_STABLE_DIFFUSION=false
WHISPER_MODEL=base

# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
